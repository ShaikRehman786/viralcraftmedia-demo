# Backup Service (port 5002)
NODE_ENV=development
PORT=5002
SERVICE_NAME=backup-service
MONGO_URI=mongodb://127.0.0.1:27017/vcm
BACKUP_MONGODB_URI=mongodb://127.0.0.1:27017/vcm_backup
INTERNAL_SERVICE_KEY=dev-internal-secret-key-change-in-production
REDIS_URL=
BACKUP_ADMIN_EMAIL=backupadmin@viralcraftmedia.com
BACKUP_ADMIN_PASSWORD=change-me
BACKUP_JWT_SECRET=change-me
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_RETRIES=10
RUN_IN_PROCESS_BACKUP=false
