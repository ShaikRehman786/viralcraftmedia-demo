# Main API Service (port 5000)
NODE_ENV=development
PORT=5000
SERVICE_NAME=main-api
MONGO_URI=mongodb://127.0.0.1:27017/vcm
INTERNAL_SERVICE_KEY=dev-internal-secret-key-change-in-production

# Split-mode flags (set false when running dedicated services)
RUN_IN_PROCESS_BACKUP=true
RUN_IN_PROCESS_WORKERS=true
RUN_IN_PROCESS_WHATSAPP=true
WHATSAPP_ADAPTER_ENABLED=false

# Remote service URLs (optional; local fallback when unset)
WHATSAPP_SERVICE_URL=http://localhost:5001
BACKUP_SERVICE_URL=http://localhost:5002
WORKER_SERVICE_URL=http://localhost:5003
REALTIME_SERVICE_URL=http://localhost:5004
