# ViralCraft Media - WhatsApp Automation Service (standalone foundation)
# Phase 2 Step 3: isolated service on port 5001. Do NOT point to production WhatsApp session.

NODE_ENV=development
PORT=5001
SERVICE_NAME=whatsapp-service

# Internal HMAC security (must match Main CRM INTERNAL_SERVICE_KEY in integrated environments)
INTERNAL_SERVICE_KEY=change-me-in-production

# Redis (required for nonce replay protection in production; fail-closed when unavailable)
# REDIS_URL=redis://localhost:6379

# MongoDB (required for WhatsApp message history ownership; optional until persistence is enabled)
# MONGO_URI=mongodb://localhost:27017/viralcraftmedia

# WhatsApp / session isolation (FOUNDATION DEFAULTS ARE ISOLATED - do not use production client/session)
WHATSAPP_CLIENT_ID=vcm-crm-whatsapp-phase2-foundation
WHATSAPP_SESSION_BASE_DIR=.wwebjs_auth
# WHATSAPP_CLEAR_SESSION_ON_LOGOUT=true

# WhatsApp Web module readiness (bounded wait before whatsapp-web.js inject)
# WA_MODULE_READY_TIMEOUT_MS=20000
# Cooldown after all init attempts fail, prevents repeated Chromium launches
# WA_TERMINAL_COOLDOWN_MS=60000


# Puppeteer / Chromium (persistent paths required in production; ephemeral storage loses sessions/cache)
# PUPPETEER_CACHE_DIR=/opt/render/project/src/services/whatsapp-service/.cache/puppeteer
# PUPPETEER_EXECUTABLE_PATH=
# PUPPETEER_SKIP_DOWNLOAD=true
